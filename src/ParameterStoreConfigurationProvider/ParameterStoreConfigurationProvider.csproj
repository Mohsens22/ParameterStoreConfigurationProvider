<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>

		<!-- First Part: Nuget information -->
		<PackageId>Mohsens22.AWS.SSM.ParameterStoreConfigurationProvider</PackageId>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Description>Use AWS ParameterStore to configure your .net project</Description>
		<PackageProjectUrl>https://github.com/mohsens22/ParameterStoreConfigurationProvider</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Bastian Töpfer, Mohsens22</Copyright>
		<RepositoryUrl>https://github.com/mohsens22/ParameterStoreConfigurationProvider</RepositoryUrl>
		<Authors>Bastian Töpfer, Mohsens22</Authors>
		<PackageTags>AWS ParameterStore Configuration</PackageTags>
		<!-- First Part: {MajorVersion}.{MinorNoneBreakingVersion} -->
		<!-- Second Part: Matching the underlying AWSSDK version -->
		<Version>2.0.3.7</Version>
		<PackageReleaseNotes>Targeting modern package versions</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AWSSDK.Core" Version="$(AWSSDK-Core)" />
		<PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="$(AWSSDK-SimpleSystemsManagement)" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="$(Microsoft-Extensions-Configuration)" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Readme.md">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
